<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROLIVO - Neon Violet Experience</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@100;200;300;400;500;600;700;800;900&family=Electrolize:wght@400&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: radial-gradient(ellipse at center, #1a0d2e 0%, #0a0014 100%);
            overflow: hidden;
            font-family: 'Orbitron', monospace;
            height: 100vh;
            position: relative;
        }
        
        /* Neon Grid Background */
        .neon-grid {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(138, 43, 226, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(138, 43, 226, 0.1) 1px, transparent 1px);
            background-size: 80px 80px;
            animation: gridGlow 4s ease-in-out infinite alternate;
        }
        
        /* Floating Neon Orbs */
        .neon-orbs {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        
        .neon-orb {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #ff00ff, #8a2be2, transparent);
            box-shadow: 0 0 20px #8a2be2, 0 0 40px #ff00ff, 0 0 60px #8a2be2;
            animation: orbFloat 6s infinite ease-in-out;
        }
        
        .orb-1 {
            width: 60px;
            height: 60px;
            top: 10%;
            left: 15%;
            animation-delay: 0s;
        }
        
        .orb-2 {
            width: 40px;
            height: 40px;
            top: 70%;
            right: 20%;
            animation-delay: 2s;
        }
        
        .orb-3 {
            width: 80px;
            height: 80px;
            bottom: 20%;
            left: 10%;
            animation-delay: 4s;
        }
        
        .orb-4 {
            width: 35px;
            height: 35px;
            top: 30%;
            right: 10%;
            animation-delay: 1s;
        }
        
        .orb-5 {
            width: 50px;
            height: 50px;
            top: 80%;
            left: 80%;
            animation-delay: 3s;
        }
        
        /* Main Logo Container */
        .logo-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            opacity: 0;
            animation: logoMaterialize 2.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) 1s forwards;
        }
        
        /* P Symbol Container */
        .p-symbol {
            position: relative;
            width: 200px;
            height: 200px;
            margin: 0 auto 50px;
            perspective: 1000px;
        }
        
        /* Neon P Design */
        .neon-p {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 140px;
            height: 140px;
            background: linear-gradient(135deg, 
                rgba(138, 43, 226, 0.8) 0%, 
                rgba(255, 0, 255, 0.6) 50%, 
                rgba(148, 0, 211, 0.8) 100%);
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 80px;
            font-weight: 800;
            color: #ffffff;
            text-shadow: 
                0 0 10px #ff00ff,
                0 0 20px #8a2be2,
                0 0 30px #ff00ff,
                0 0 40px #8a2be2;
            box-shadow: 
                0 0 30px rgba(138, 43, 226, 0.8),
                0 0 60px rgba(255, 0, 255, 0.6),
                inset 0 0 30px rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 0, 255, 0.5);
            animation: pPulse 3s infinite ease-in-out;
            backdrop-filter: blur(10px);
        }
        
        /* Electric Rings */
        .electric-ring {
            position: absolute;
            top: 50%;
            left: 50%;
            border: 3px solid;
            border-radius: 50%;
            border-image: linear-gradient(45deg, #ff00ff, #8a2be2, #ff00ff) 1;
            animation: electricRotate 4s linear infinite;
            box-shadow: 
                0 0 20px #ff00ff,
                inset 0 0 20px rgba(255, 0, 255, 0.2);
        }
        
        .ring-1 {
            width: 180px;
            height: 180px;
            margin: -90px 0 0 -90px;
            animation-delay: 0s;
            border-color: #ff00ff;
        }
        
        .ring-2 {
            width: 220px;
            height: 220px;
            margin: -110px 0 0 -110px;
            animation-delay: 1s;
            animation-direction: reverse;
            border-color: #8a2be2;
        }
        
        .ring-3 {
            width: 260px;
            height: 260px;
            margin: -130px 0 0 -130px;
            animation-delay: 2s;
            border-color: #9400d3;
        }
        
        /* Lightning Bolts */
        .lightning-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 300px;
            height: 300px;
            pointer-events: none;
        }
        
        .lightning {
            position: absolute;
            width: 4px;
            height: 80px;
            background: linear-gradient(to bottom, 
                #ff00ff 0%, 
                #8a2be2 50%, 
                transparent 100%);
            border-radius: 2px;
            box-shadow: 
                0 0 10px #ff00ff,
                0 0 20px #8a2be2;
            animation: lightningStrike 2s infinite;
            transform-origin: bottom center;
        }
        
        .lightning:nth-child(1) {
            top: 10%;
            left: 20%;
            animation-delay: 0s;
            transform: rotate(15deg);
        }
        
        .lightning:nth-child(2) {
            top: 30%;
            right: 15%;
            animation-delay: 0.5s;
            transform: rotate(-30deg);
        }
        
        .lightning:nth-child(3) {
            bottom: 20%;
            left: 30%;
            animation-delay: 1s;
            transform: rotate(45deg);
        }
        
        .lightning:nth-child(4) {
            bottom: 10%;
            right: 25%;
            animation-delay: 1.5s;
            transform: rotate(-15deg);
        }
        
        /* PROLIVO Text */
        .prolivo-text {
            font-family: 'Electrolize', sans-serif;
            font-size: 100px;
            font-weight: 400;
            color: transparent;
            background: linear-gradient(45deg, 
                #ff00ff 0%, 
                #8a2be2 25%, 
                #ff00ff 50%, 
                #9400d3 75%, 
                #ff00ff 100%);
            background-size: 400% 400%;
            background-clip: text;
            -webkit-background-clip: text;
            animation: textNeonFlow 3s ease-in-out infinite;
            text-shadow: 
                0 0 20px rgba(255, 0, 255, 0.8),
                0 0 40px rgba(138, 43, 226, 0.6),
                0 0 60px rgba(255, 0, 255, 0.4);
            letter-spacing: 8px;
            position: relative;
        }
        
        .prolivo-text .letter {
            display: inline-block;
            opacity: 0;
            transform: translateY(100px) rotateZ(45deg) scale(0);
            animation: letterNeonReveal 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
        }
        
        .prolivo-text .letter:nth-child(1) { animation-delay: 2s; }
        .prolivo-text .letter:nth-child(2) { animation-delay: 2.2s; }
        .prolivo-text .letter:nth-child(3) { animation-delay: 2.4s; }
        .prolivo-text .letter:nth-child(4) { animation-delay: 2.6s; }
        .prolivo-text .letter:nth-child(5) { animation-delay: 2.8s; }
        .prolivo-text .letter:nth-child(6) { animation-delay: 3s; }
        .prolivo-text .letter:nth-child(7) { animation-delay: 3.2s; }
        
        /* Neon Glow Effect */
        .prolivo-text::before {
            content: 'PROLIVO';
            position: absolute;
            top: 0;
            left: 0;
            color: #ff00ff;
            filter: blur(15px);
            opacity: 0.7;
            animation: textNeonFlow 3s ease-in-out infinite;
            z-index: -1;
        }
        
        /* Electric Particles */
        .electric-particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        
        .electric-particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, #ff00ff, #8a2be2);
            border-radius: 50%;
            box-shadow: 
                0 0 15px #ff00ff,
                0 0 30px #8a2be2;
            animation: particleElectric 3s infinite ease-in-out;
        }
        
        /* Scan Lines Effect */
        .scan-lines {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(255, 0, 255, 0.03) 2px,
                rgba(255, 0, 255, 0.03) 4px
            );
            animation: scanLinesMove 2s linear infinite;
            pointer-events: none;
        }
        
        /* Neon Border Frame */
        .neon-frame {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: calc(100vw - 100px);
            height: calc(100vh - 100px);
            border: 2px solid transparent;
            border-image: linear-gradient(45deg, 
                #ff00ff, 
                #8a2be2, 
                #9400d3, 
                #ff00ff) 1;
            border-radius: 20px;
            box-shadow: 
                0 0 30px rgba(255, 0, 255, 0.3),
                inset 0 0 30px rgba(138, 43, 226, 0.1);
            animation: frameGlow 4s ease-in-out infinite alternate;
            opacity: 0;
            animation-delay: 4s;
        }
        
        /* Completion Explosion */
        .neon-explosion {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 0;
            height: 0;
            border-radius: 50%;
            background: radial-gradient(circle, 
                rgba(255, 0, 255, 0.8) 0%, 
                rgba(138, 43, 226, 0.6) 30%, 
                transparent 70%);
            opacity: 0;
            animation: neonExplosion 2s ease-out 5s forwards;
            pointer-events: none;
        }
        
        /* Interactive Hint */
        .interaction-hint {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: #ff00ff;
            font-size: 16px;
            font-weight: 300;
            text-align: center;
            opacity: 0;
            animation: hintNeonAppear 1s ease-out 6s forwards;
            background: rgba(138, 43, 226, 0.1);
            padding: 15px 30px;
            border-radius: 30px;
            border: 1px solid rgba(255, 0, 255, 0.3);
            backdrop-filter: blur(10px);
            box-shadow: 
                0 0 20px rgba(255, 0, 255, 0.3),
                inset 0 0 20px rgba(138, 43, 226, 0.1);
            text-shadow: 0 0 10px #ff00ff;
        }
        
        /* ANIMATIONS */
        
        @keyframes gridGlow {
            0% { opacity: 0.3; }
            100% { opacity: 0.8; }
        }
        
        @keyframes orbFloat {
            0%, 100% {
                transform: translateY(0px) scale(1);
                opacity: 0.7;
            }
            33% {
                transform: translateY(-30px) scale(1.1);
                opacity: 1;
            }
            66% {
                transform: translateY(15px) scale(0.9);
                opacity: 0.8;
            }
        }
        
        @keyframes logoMaterialize {
            0% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.3) rotateY(180deg);
                filter: blur(20px);
            }
            60% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1.1) rotateY(-10deg);
                filter: blur(5px);
            }
            100% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1) rotateY(0deg);
                filter: blur(0px);
            }
        }
        
        @keyframes pPulse {
            0%, 100% {
                transform: translate(-50%, -50%) scale(1);
                box-shadow: 
                    0 0 30px rgba(138, 43, 226, 0.8),
                    0 0 60px rgba(255, 0, 255, 0.6),
                    inset 0 0 30px rgba(255, 255, 255, 0.1);
            }
            50% {
                transform: translate(-50%, -50%) scale(1.05);
                box-shadow: 
                    0 0 50px rgba(138, 43, 226, 1),
                    0 0 100px rgba(255, 0, 255, 0.8),
                    inset 0 0 50px rgba(255, 255, 255, 0.2);
            }
        }
        
        @keyframes electricRotate {
            0% {
                transform: translate(-50%, -50%) rotate(0deg);
                opacity: 1;
            }
            50% {
                opacity: 0.6;
            }
            100% {
                transform: translate(-50%, -50%) rotate(360deg);
                opacity: 1;
            }
        }
        
        @keyframes lightningStrike {
            0%, 90%, 100% {
                opacity: 0;
                transform: translateY(0) scale(1);
            }
            5%, 10% {
                opacity: 1;
                transform: translateY(-10px) scale(1.2);
            }
        }
        
        @keyframes letterNeonReveal {
            0% {
                opacity: 0;
                transform: translateY(100px) rotateZ(45deg) scale(0);
            }
            60% {
                opacity: 1;
                transform: translateY(-20px) rotateZ(-10deg) scale(1.1);
            }
            100% {
                opacity: 1;
                transform: translateY(0) rotateZ(0deg) scale(1);
            }
        }
        
        @keyframes textNeonFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        @keyframes particleElectric {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
                opacity: 0.8;
            }
            25% {
                transform: translateY(-20px) rotate(90deg);
                opacity: 1;
            }
            50% {
                transform: translateY(10px) rotate(180deg);
                opacity: 0.6;
            }
            75% {
                transform: translateY(-15px) rotate(270deg);
                opacity: 1;
            }
        }
        
        @keyframes scanLinesMove {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100%); }
        }
        
        @keyframes frameGlow {
            0% {
                opacity: 0.3;
                box-shadow: 
                    0 0 30px rgba(255, 0, 255, 0.3),
                    inset 0 0 30px rgba(138, 43, 226, 0.1);
            }
            100% {
                opacity: 0.8;
                box-shadow: 
                    0 0 60px rgba(255, 0, 255, 0.6),
                    inset 0 0 60px rgba(138, 43, 226, 0.2);
            }
        }
        
        @keyframes neonExplosion {
            0% {
                width: 0;
                height: 0;
                opacity: 0;
            }
            50% {
                width: 800px;
                height: 800px;
                margin: -400px 0 0 -400px;
                opacity: 0.8;
            }
            100% {
                width: 1600px;
                height: 1600px;
                margin: -800px 0 0 -800px;
                opacity: 0;
            }
        }
        
        @keyframes hintNeonAppear {
            0% {
                opacity: 0;
                transform: translateX(-50%) translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }
        
        /* Hover Effects */
        .logo-container:hover .neon-p {
            animation-duration: 1.5s;
            transform: translate(-50%, -50%) scale(1.1);
        }
        
        .logo-container:hover .electric-ring {
            animation-duration: 2s;
        }
        
        .logo-container:hover .prolivo-text {
            animation-duration: 1.5s;
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .p-symbol {
                width: 150px;
                height: 150px;
                margin-bottom: 30px;
            }
            
            .neon-p {
                width: 100px;
                height: 100px;
                font-size: 60px;
            }
            
            .prolivo-text {
                font-size: 60px;
                letter-spacing: 4px;
            }
            
            .electric-ring {
                border-width: 2px;
            }
            
            .ring-1 { width: 130px; height: 130px; margin: -65px 0 0 -65px; }
            .ring-2 { width: 160px; height: 160px; margin: -80px 0 0 -80px; }
            .ring-3 { width: 190px; height: 190px; margin: -95px 0 0 -95px; }
        }
        
        @media (max-width: 480px) {
            .prolivo-text {
                font-size: 40px;
                letter-spacing: 2px;
            }
            
            .p-symbol {
                width: 120px;
                height: 120px;
            }
            
            .neon-p {
                width: 80px;
                height: 80px;
                font-size: 40px;
            }
            
            .interaction-hint {
                font-size: 14px;
                padding: 12px 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Neon Grid Background -->
    <div class="neon-grid"></div>
    
    <!-- Floating Neon Orbs -->
    <div class="neon-orbs">
        <div class="neon-orb orb-1"></div>
        <div class="neon-orb orb-2"></div>
        <div class="neon-orb orb-3"></div>
        <div class="neon-orb orb-4"></div>
        <div class="neon-orb orb-5"></div>
    </div>
    
    <!-- Electric Particles -->
    <div class="electric-particles" id="electricParticles"></div>
    
    <!-- Scan Lines -->
    <div class="scan-lines"></div>
    
    <!-- Neon Frame -->
    <div class="neon-frame"></div>
    
    <!-- Main Logo -->
    <div class="logo-container" id="logoContainer">
        <div class="p-symbol">
            <!-- Lightning Container -->
            <div class="lightning-container">
                <div class="lightning"></div>
                <div class="lightning"></div>
                <div class="lightning"></div>
                <div class="lightning"></div>
            </div>
            
            <!-- Electric Rings -->
            <div class="electric-ring ring-1"></div>
            <div class="electric-ring ring-2"></div>
            <div class="electric-ring ring-3"></div>
            
            <!-- Neon P -->
            <div class="neon-p">P</div>
        </div>
        
        <!-- PROLIVO Text -->
        <div class="prolivo-text">
            <span class="letter">P</span>
            <span class="letter">R</span>
            <span class="letter">O</span>
            <span class="letter">L</span>
            <span class="letter">I</span>
            <span class="letter">V</span>
            <span class="letter">O</span>
        </div>
    </div>
    
    <!-- Completion Explosion -->
    <div class="neon-explosion"></div>
    
    <!-- Interaction Hint -->
    <div class="interaction-hint">
        Experience the neon glow • Click anywhere to restart
    </div>
    
    <script>
        // Generate Electric Particles
        function generateElectricParticles() {
            const container = document.getElementById('electricParticles');
            const particleCount = 25;
            
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'electric-particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 3 + 's';
                particle.style.animationDuration = (2 + Math.random() * 2) + 's';
                container.appendChild(particle);
            }
        }
        
        // Mouse tracking with neon trail
        let mouseX = 0, mouseY = 0;
        const trail = [];
        
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            
            // Add to trail
            trail.push({ x: mouseX, y: mouseY, time: Date.now() });
            if (trail.length > 15) trail.shift();
            
            // Move logo slightly with mouse
            const logoContainer = document.getElementById('logoContainer');
            const rect = logoContainer.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            
            const deltaX = (mouseX - centerX) / window.innerWidth * 20;
            const deltaY = (mouseY - centerY) / window.innerHeight * 20;
            
            logoContainer.style.transform = `
                translate(-50%, -50%) 
                translate(${deltaX}px, ${deltaY}px)
                rotateX(${deltaY * 0.1}deg) 
                rotateY(${deltaX * 0.1}deg)
            `;
        });
        
        // Render mouse trail
        function renderMouseTrail() {
            const now = Date.now();
            
            // Remove old trail elements
            document.querySelectorAll('.mouse-trail').forEach(el => el.remove());
            
            trail.forEach((point, index) => {
                const age = now - point.time;
                if (age > 1000) return;
                
                const opacity = Math.max(0, 1 - age / 1000);
                const size = Math.max(4, 12 - (age / 100));
                
                const trailDot = document.createElement('div');
                trailDot.className = 'mouse-trail';
                trailDot.style.cssText = `
                    position: fixed;
                    left: ${point.x - size/2}px;
                    top: ${point.y - size/2}px;
                    width: ${size}px;
                    height: ${size}px;
                    background: radial-gradient(circle, 
                        rgba(255,0,255,${opacity}), 
                        rgba(138,43,226,${opacity * 0.5}), 
                        transparent);
                    border-radius: 50%;
                    pointer-events: none;
                    z-index: 1000;
                    box-shadow: 0 0 ${size * 2}px rgba(255,0,255,${opacity * 0.8});
                `;
                
                document.body.appendChild(trailDot);
            });
            
            requestAnimationFrame(renderMouseTrail);
        }
        renderMouseTrail();
        
        // Click effects
        document.addEventListener('click', (e) => {
            createNeonBurst(e.clientX, e.clientY);
            
            // Restart animation
            setTimeout(() => {
                location.reload();
            }, 800);
        });
        
        function createNeonBurst(x, y) {
            for (let i = 0; i < 12; i++) {
                const burst = document.createElement('div');
                const angle = (i / 12) * Math.PI * 2;
                const velocity = 150 + Math.random() * 100;
                
                burst.style.cssText = `
                    position: fixed;
                    left: ${x}px;
                    top: ${y}px;
                    width: 8px;
                    height: 8px;
                    background: radial-gradient(circle, #ff00ff, #8a2be2);
                    border-radius: 50%;
                    pointer-events: none;
                    z-index: 9999;
                    box-shadow: 0 0 20px #ff00ff, 0 0 40px #8a2be2;
                    animation: neonBurstParticle 1.5s ease-out forwards;
                `;
                
                burst.style.setProperty('--vx', Math.cos(angle) * velocity + 'px');
                burst.style.setProperty('--vy', Math.sin(angle) * velocity + 'px');
                
                document.body.appendChild(burst);
                setTimeout(() => burst.remove(), 1500);
            }
        }
        
        // Add burst animation
        const burstStyle = document.createElement('style');
        burstStyle.textContent = `
            @keyframes neonBurstParticle {
                0% {
                    opacity: 1;
                    transform: translate(0, 0) scale(1);
                }
                100% {
                    opacity: 0;
                    transform: translate(var(--vx), var(--vy)) scale(0);
                }
            }
        `;
        document.head.appendChild(burstStyle);
        
        // Random lightning strikes
        function createRandomLightning() {
            const lightning = document.createElement('div');
            lightning.style.cssText = `
                position: fixed;
                left: ${Math.random() * 100}%;
                top: ${Math.random() * 100}%;
                width: 3px;
                height: 60px;
                background: linear-gradient(to bottom, #ff00ff, transparent);
                box-shadow: 0 0 15px #ff00ff, 0 0 30px #8a2be2;
                border-radius: 2px;
                pointer-events: none;
                z-index: 500;
                animation: randomLightningStrike 0.3s ease-out forwards;
            `;
            
            document.body.appendChild(lightning);
            setTimeout(() => lightning.remove(), 300);
        }
        
        const lightningStyle = document.createElement('style');
        lightningStyle.textContent = `
            @keyframes randomLightningStrike {
                0% {
                    opacity: 0;
                    transform: scaleY(0);
                }
                50% {
                    opacity: 1;
                    transform: scaleY(1.2);
                }
                100% {
                    opacity: 0;
                    transform: scaleY(1);
                }
            }
        `;
        document.head.appendChild(lightningStyle);
        
        // Create random lightning every few seconds
        setInterval(() => {
            if (Math.random() > 0.7) {
                createRandomLightning();
            }
        }, 2000);
        
        // Neon pulse wave effect
        function createNeonPulse() {
            const pulse = document.createElement('div');
            pulse.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 0;
                height: 0;
                border: 4px solid rgba(255, 0, 255, 0.8);
                border-radius: 50%;
                pointer-events: none;
                z-index: 100;
                animation: neonPulseWave 3s ease-out forwards;
                box-shadow: 0 0 30px #ff00ff, inset 0 0 30px rgba(255, 0, 255, 0.2);
            `;
            
            document.body.appendChild(pulse);
            setTimeout(() => pulse.remove(), 3000);
        }
        
        const pulseStyle = document.createElement('style');
        pulseStyle.textContent = `
            @keyframes neonPulseWave {
                0% {
                    width: 0;
                    height: 0;
                    opacity: 1;
                }
                100% {
                    width: 1000px;
                    height: 1000px;
                    margin: -500px 0 0 -500px;
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(pulseStyle);
        
        // Create pulse waves periodically
        setInterval(() => {
            if (Math.random() > 0.8) {
                createNeonPulse();
            }
        }, 4000);
        
        // Electric current effect on mouse movement
        document.addEventListener('mousemove', (e) => {
            if (Math.random() > 0.95) {
                createElectricSpark(e.clientX, e.clientY);
            }
        });
        
        function createElectricSpark(x, y) {
            const spark = document.createElement('div');
            spark.style.cssText = `
                position: fixed;
                left: ${x - 5}px;
                top: ${y - 5}px;
                width: 10px;
                height: 10px;
                background: radial-gradient(circle, #ff00ff, transparent);
                border-radius: 50%;
                pointer-events: none;
                z-index: 1001;
                box-shadow: 0 0 20px #ff00ff;
                animation: sparkFade 0.5s ease-out forwards;
            `;
            
            document.body.appendChild(spark);
            setTimeout(() => spark.remove(), 500);
        }
        
        const sparkStyle = document.createElement('style');
        sparkStyle.textContent = `
            @keyframes sparkFade {
                0% {
                    opacity: 1;
                    transform: scale(1);
                }
                100% {
                    opacity: 0;
                    transform: scale(3);
                }
            }
        `;
        document.head.appendChild(sparkStyle);
        
        // Glitch effect
        function createGlitchEffect() {
            const logoContainer = document.getElementById('logoContainer');
            const originalFilter = logoContainer.style.filter;
            const originalTransform = logoContainer.style.transform;
            
            logoContainer.style.filter = 'hue-rotate(60deg) saturate(2) brightness(1.3)';
            logoContainer.style.transform = originalTransform + ' skew(2deg, 1deg)';
            
            setTimeout(() => {
                logoContainer.style.filter = originalFilter;
                logoContainer.style.transform = originalTransform;
            }, 100);
        }
        
        // Random glitch effects
        setInterval(() => {
            if (Math.random() > 0.9) {
                createGlitchEffect();
            }
        }, 3000);
        
        // Initialize electric particles
        generateElectricParticles();
        
        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            switch(e.key) {
                case ' ':
                    e.preventDefault();
                    createNeonPulse();
                    break;
                case 'Enter':
                    e.preventDefault();
                    createGlitchEffect();
                    break;
                case 'l':
                case 'L':
                    createRandomLightning();
                    break;
                case 'Escape':
                    location.reload();
                    break;
            }
        });
        
        // Performance optimization
        window.addEventListener('load', () => {
            document.body.style.willChange = 'auto';
        });
        
        // Enhanced neon glow on specific events
        setTimeout(() => {
            const allNeonElements = document.querySelectorAll('.neon-p, .prolivo-text, .electric-ring');
            allNeonElements.forEach(el => {
                el.style.filter = 'brightness(1.2) saturate(1.3)';
            });
        }, 7000);
        
        // Add extra visual flair with floating text
        setTimeout(() => {
            const floatingText = document.createElement('div');
            floatingText.style.cssText = `
                position: absolute;
                bottom: 100px;
                left: 50%;
                transform: translateX(-50%);
                color: rgba(255, 0, 255, 0.4);
                font-size: 12px;
                font-family: 'Orbitron', monospace;
                text-align: center;
                opacity: 0;
                animation: floatingTextAppear 2s ease-out forwards;
                text-shadow: 0 0 10px rgba(255, 0, 255, 0.6);
            `;
            floatingText.textContent = '◊ NEON PROTOCOL INITIALIZED ◊';
            document.body.appendChild(floatingText);
        }, 8000);
        
        const floatingStyle = document.createElement('style');
        floatingStyle.textContent = `
            @keyframes floatingTextAppear {
                0% {
                    opacity: 0;
                    transform: translateX(-50%) translateY(20px);
                }
                100% {
                    opacity: 0.6;
                    transform: translateX(-50%) translateY(0);
                }
            }
        `;
        document.head.appendChild(floatingStyle);
    </script>
</body>
</html>
